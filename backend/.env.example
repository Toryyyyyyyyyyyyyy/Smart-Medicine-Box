# 复制本文件为 .env 并按需修改（.env 已被 .gitignore 排除，勿提交真实秘密）

# 部署模式：lan = 局域网直连（自签 TLS + 配对）；public = 公网（Caddy 反代终结 TLS）
DEPLOY_MODE=lan

# JWT 签名密钥：留空则首次启动自动生成并保存到 backend/.secret_key。
# 轮换密钥会使所有已签发令牌（用户/家属/管理员）立即失效。
# SECRET_KEY=

# 监听地址与端口（public 模式默认只监听 127.0.0.1）
# HOST=0.0.0.0
PORT=8000

# 管理员初始凭据：仅在数据库中「没有任何管理员记录」时生效（首次启动播种）。
# 之后修改这里不会改变已初始化的管理员密码——改密请在管理网站进行；
# 忘记密码请在服务器本机执行 python cli.py reset-admin。
# 默认 Admin/123456 仅用于初始化，切勿当作公网长期密码使用。
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=123456

# 管理员会话有效期（小时）
ADMIN_TOKEN_EXPIRE_HOURS=12

# 严格模式：未修改默认密码前禁用管理网站的用户管理功能（公网部署建议 true）
ADMIN_FORCE_PASSWORD_CHANGE=false

# 服务器身份密钥/自签证书路径（默认 backend/server_identity/，自动生成）
# TLS_CERT_FILE=
# TLS_KEY_FILE=
